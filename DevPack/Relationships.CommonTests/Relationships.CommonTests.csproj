		<UseVSTest>true</UseVSTest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="FluentAssertions" />
		<PackageReference Include="PublicApiGenerator" />
		<PackageReference Include="Verify.MSTest" />
		<PackageReference Include="Moq" />
		<PackageReference Include="Skyline.DataMiner.Utils.DOM" />
		<PackageReference Include="Skyline.DataMiner.Dev.Automation" />
		<PackageReference Include="Skyline.DataMiner.Dev.Utils.SDM.Abstractions" />
		<PackageReference Include="Skyline.DataMiner.SDM.SourceGenerator.Runtime" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(DevPackDir)\Relationships.Common\Relationships.Common.csproj" />
		<ProjectReference Include="$(PackageDir)\Install\Relationships.Install.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Exposers\" />
	  <Folder Include="Traversal\" />
	</ItemGroup>
</Project>
